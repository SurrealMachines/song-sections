{
  "name": "song-sections",
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts --production",
    "build:dev": "tsc --noEmit && tsx build.ts",
    "dialog:preview": "tsx build.ts --production && tsx scripts/dialog-preview.ts",
    "start": "npm run build:dev && mkdir -p .dev/storage .dev/temp && extensions-cli run --storage-directory \"$PWD/.dev/storage\" --temp-directory \"$PWD/.dev/temp\"",
    "package": "npm run build && extensions-cli package -i native -i licenses -i models",
    "check": "tsx scripts/check.ts",
    "test": "vitest run",
    "test:perf": "SONG_SECTIONS_PERF=1 vitest run",
    "fixtures": "sh tools/golden/make_all.sh",
    "models:dev": "tsx scripts/models-dev.ts",
    "patterns:score": "tsx scripts/patterns-score.ts",
    "patterns:report": "tsx scripts/patterns-report.ts"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "fft.js": "4.0.4",
    "meyda": "^5.6.3",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@patchbayhq/svelte": "^0.1.2",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.0",
    "esbuild-svelte": "^0.9.5",
    "jsdom": "^30.1.3",
    "svelte": "^5",
    "svelte-check": "^4.7.7",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
